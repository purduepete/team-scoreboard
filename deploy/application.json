{
  "schemaVersion": 1,
  "id": "team-scoreboard",
  "repository": "https://github.com/purduepete/team-scoreboard.git",
  "database": {
    "engine": "postgresql",
    "name": "team_scoreboard",
    "connectionEnvironment": "DATABASE_URL",
    "backendEnvironment": "STORAGE_BACKEND",
    "schemaVersion": 1,
    "migrationsDirectory": "deploy\\postgresql",
    "backupFormat": "custom"
  },
  "runtime": { "kind": "node", "minimumVersion": "22.12.0" },
