  "launch": {
    "entrypoint": "dist-server\\server\\main.js",
    "arguments": [],
    "port": 8801,
    "environment": {
      "PORT": "8801",
      "STORAGE_BACKEND": "postgresql",
      "ALLOWED_ORIGINS": "https://team-scoreboard.jimlertech.com,https://jimbrownhome1.tail8ad282.ts.net:8801,http://127.0.0.1:8801"
    },
    "secretFile": "app.env",
    "stopFileEnvironment": "SOLUTIONDEPLOY_STOP_FILE"
  },
  "readiness": { "path": "/api/health", "expected": { "ok": true }, "timeoutSeconds": 60 },
  "state": [],
  "managedState": [],
  "routes": [{ "hostname": "team-scoreboard.jimlertech.com" }],
