STORAGE_BACKEND=postgresql
# Set DATABASE_URL only in the protected runtime environment, never in source control.
PORT=8801
ALLOWED_ORIGINS=http://127.0.0.1:8801,http://127.0.0.1:5173
# Optional: settled past scoreboard days are saved here across restarts.
SCOREBOARD_CACHE_FILE=
# Optional game alerts. Set both only in the protected runtime environment.
# PUSHOVER_USER_KEY=
# PUSHOVER_APP_TOKEN=
